{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "compact", "name": "Compact", "size": "0.75rem" },
        { "slug": "regular", "name": "Regular", "size": "1.25rem" },
        { "slug": "gutter", "name": "Gutter", "size": "clamp(1rem, 4vw, 3rem)" },
        { "slug": "grid", "name": "Grid", "size": "clamp(1rem, 3vw, 2.5rem)" },
        { "slug": "section", "name": "Section", "size": "clamp(3rem, 7vw, 6rem)" }
      ]
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#080d09",
          "name": "Ink"
        },
        {
          "slug": "surface",
          "color": "#141f16",
          "name": "Surface"
        },
        {
          "slug": "paper",
          "color": "#f1f4eb",
          "name": "Paper"
        },
        {
          "slug": "text",
          "color": "#f3f6ef",
          "name": "Text"
        },
        {
          "slug": "muted",
          "color": "#b4c3b3",
          "name": "Muted"
        },
        {
          "slug": "accent",
          "color": "#d9fb4f",
          "name": "Lime"
        },
        {
          "slug": "deep",
          "color": "#435d29",
          "name": "Deep green"
        }
      ]
    },
    "typography": {
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "body", "name": "Body", "size": "1rem" },
        { "slug": "card", "name": "Card", "size": "clamp(1.15rem, 2vw, 1.5rem)", "fluid": false },
        { "slug": "section-title", "name": "Section title", "size": "clamp(2rem, 4.5vw, 4.25rem)", "fluid": false },
        { "slug": "display", "name": "Display", "size": "clamp(2.65rem, 6.2vw, 6.5rem)", "fluid": false }
      ],
      "fontFamilies": [
        {
          "slug": "body",
          "name": "System Sans",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "mono",
          "name": "System Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Consolas, monospace"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ink",
      "text": "var:preset|color|text"
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|gutter",
        "right": "var:preset|spacing|gutter"
      },
      "blockGap": "var:preset|spacing|regular"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "750",
          "lineHeight": "1.12",
          "letterSpacing": "-0.04em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      },
      "button": {
        "border": {
          "radius": "3px"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|ink"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.15rem",
            "right": "1.15rem"
          }
        },
        "typography": {
          "fontWeight": "750"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "service-landing",
      "title": "Zion · Servicii",
      "postTypes": ["page"]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "page-sidebar",
      "title": "Bară laterală pagini",
      "area": "uncategorized"
    }
  ]
}
